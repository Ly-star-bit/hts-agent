.cache/

# ===== Build artifacts: rebuilt by scripts/build_db.py, NOT source =====
# 原始数据（htsdata.csv / 两份 PDF）与人工转录数据（data/*.json）仍然跟踪；
# 下面三个是 build_db.py 的衍生产物，跟踪它们只会带来 4MB 级的不可读 diff。
data/sec301_db.json
data/.db_fingerprint.json
data/.db_changes.json

# CROSS 裁定库本地镜像（69MB，scripts/cross_sync.py 随时可重建）
data/cross.db
data/cross.db-shm
data/cross.db-wal
