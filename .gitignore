# ===== Runtime output (generated, not source) =====
output/

# CROSS（CBP 裁定库）的本地查询缓存 + 按需拉取的裁定正文，随时可重拉，不入 git
.cache/

# ===== Build artifacts: rebuilt by scripts/build_db.py, NOT source =====
# 原始数据（htsdata.csv / 两份 PDF）与人工转录数据（data/*.json）仍然跟踪；
# 下面三个是 build_db.py 的衍生产物，跟踪它们只会带来 4MB 级的不可读 diff。
data/sec301_db.json
data/.db_fingerprint.json
data/.db_changes.json
# scripts/check_sources.py 最近一次官方源更新探测结果（本机状态，不入 git）
data/.sources_state.json

# CROSS 裁定库本地镜像（69MB，scripts/cross_sync.py 随时可重建）
data/cross.db
data/cross.db-shm
data/cross.db-wal

# 税则行语义索引（55MB，scripts/hts_embed.py 约 18 分钟可重建）
data/hts_vec.db
data/hts_vec.db-shm
data/hts_vec.db-wal

# HTS 第 99 章全文（13MB）。另外三份官方源（htsdata.csv / China Tariffs / FLIP FRN）
# 都跟踪，唯独这份不入 git —— 体积是它们加起来的两倍，而且判定并不直接读它：
# 判定读的是它的产物 data/sec301_exclusions.json（已跟踪），PDF 只在重新提取排除清单时需要。
# 缺文件时：python scripts/check_sources.py --apply --only ch99_pdf
Chapter 99_*.pdf

# Playwright MCP 的临时快照/截图
.playwright-mcp/
# 界面截图（贴给 Claude 看的那种），不进仓库
*.png
!static/**/*.png

# 本公司先例库（含公司品名，不入库）
data/company.db
data/company.db-shm
data/company.db-wal

# 公司清关数据（含品名/单价，不入 git）
result_*.json
